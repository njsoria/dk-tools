{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "dk-tools",
  "description": "Small tools for day-to-day work at DevKore.",
  "owner": {
    "name": "DevKore",
    "url": "https://github.com/njsoria/dk-tools"
  },
  "plugins": [
    {
      "name": "kore-model-router",
      "source": "./kore-router",
      "description": "Sends each prompt and each subagent to the model and effort its task deserves, with guards that raise a turn when quality is at risk.",
      "version": "0.7.0",
      "author": {
        "name": "Nate Soria",
        "url": "https://github.com/njsoria"
      },
      "homepage": "https://github.com/njsoria/dk-tools/tree/main/kore-router",
      "repository": "https://github.com/njsoria/dk-tools",
      "license": "MIT",
      "keywords": [
        "routing",
        "model-selection",
        "effort",
        "subagents",
        "hooks"
      ]
    },
    {
      "name": "kore-finisher",
      "source": "./kore-finisher",
      "description": "Lists what is outstanding across your Claude sessions: sessions waiting on you, and your open pull requests.",
      "version": "0.1.0",
      "author": {
        "name": "Nate Soria",
        "url": "https://github.com/njsoria"
      },
      "homepage": "https://github.com/njsoria/dk-tools/tree/main/kore-finisher",
      "repository": "https://github.com/njsoria/dk-tools",
      "license": "MIT",
      "keywords": [
        "sessions",
        "pull-requests",
        "waiting",
        "inbox"
      ]
    }
  ]
}
